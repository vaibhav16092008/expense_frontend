# =============================================================================
# ExpenseIQ Frontend — Environment Variables Template
# =============================================================================
# Copy this file to .env.local for local development.
# In production, configure these variables in your deployment platform settings.
#
# RULES:
# - Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# - NEVER put secret keys, private credentials, or database passwords here.
# =============================================================================

# Backend REST API base URL (must point to /api endpoint)
# Development default: http://localhost:4000/api
# Production example: https://api.expenseiq.app/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Optional: Allow unauthenticated preview / demo mode (default: false)
# When set to "true", mock data or preview mode is enabled (development only).
NEXT_PUBLIC_ALLOW_UNAUTH=false
